<?xml version="1.0"?>
<mavlink>
    <include>simba_radio.xml</include>
    <version>3</version>
    <dialect>3</dialect>

    <enums>
        <enum name="ROCKET_STATE">
            <description>Rocket states</description>
            <entry value="1"  name="ROCKET_STATE_INIT" />
            <entry value="2"  name="ROCKET_STATE_DISARM" />
            <entry value="3"  name="ROCKET_STATE_ARM" />
            <entry value="4"  name="ROCKET_STATE_PRESSURIZE" />
            <entry value="5"  name="ROCKET_STATE_LAUNCH" />
            <entry value="6"  name="ROCKET_STATE_FLIGHT" />
            <entry value="7"  name="ROCKET_STATE_APOGEE" />
            <entry value="8"  name="ROCKET_STATE_TOUCHDOWN" />
            <entry value="54" name="ROCKET_STATE_CONNECTION_LOST" />
            <entry value="64" name="ROCKET_STATE_ABORT" />
        </enum>

        <enum name="ACTUATOR_FLAGS" bitmask="true">
            <entry value="1"  name="ACTUATOR_FLAGS_OXIDIZER_MAIN_VALVE" />
            <entry value="2"  name="ACTUATOR_FLAGS_OXIDIZER_VENT_VALVE" />
            <entry value="4"  name="ACTUATOR_FLAGS_OXIDIZER_DUMP_VALVE" />
            <entry value="8"  name="ACTUATOR_FLAGS_ETHANOL_MAIN_VALVE" />
            <entry value="16" name="ACTUATOR_FLAGS_ETHANOL_VENT_VALVE" />
            <entry value="32" name="ACTUATOR_FLAGS_ETHANOL_DUMP_VALVE" />
            <entry value="64" name="ACTUATOR_FLAGS_PFS_MAIN_VALVE" />
            <entry value="128" name="ACTUATOR_FLAGS_PFS_VENT_VALVE" />
            <entry value="256" name="ACTUATOR_FLAGS_PFS_DUMP_VALVE" />
            <entry value="512" name="ACTUATOR_FLAGS_CAMERAS_ENABLED" />
            <entry value="1024" name="ACTUATOR_FLAGS_LOGGER_ENABLED" />
        </enum>

        <enum name="PRIMER_STATE">
            <entry value="0" name="PRIMER_STATE_UNKNOWN" />
            <entry value="1" name="PRIMER_STATE_NOT_CONNECTED" />
            <entry value="2" name="PRIMER_STATE_CONNECTED" />
            <entry value="3" name="PRIMER_STATE_SHORT_CIRCUIT" />
            <entry value="4" name="PRIMER_STATE_FIRED" />
        </enum>

        <enum name="GS_FLAGS" bitmask="true">
            <!-- Flags which the GSE uses to change rocket states. -->
            <entry value="1"  name="GS_FLAGS_DISARM" />
            <entry value="2"  name="GS_FLAGS_ARM" />
            <entry value="4"  name="GS_FLAGS_PRESSURIZE" />
            <entry value="8"  name="GS_FLAGS_LAUNCH" />
            <entry value="16" name="GS_FLAGS_ABORT" />

            <entry value="32" name="GS_FLAGS_OXIDIZER_VENT_VALVE" />
            <entry value="64" name="GS_FLAGS_OXIDIZER_DUMP_VALVE" />

            <entry value="128" name="GS_FLAGS_PFS_VENT_VALVE" />
            <entry value="256" name="GS_FLAGS_PFS_DUMP_VALVE" />

            <entry value="512" name="GS_FLAGS_ETHANOL_VENT_VALVE" />
            <entry value="1024" name="GS_FLAGS_ETHANOL_DUMP_VALVE" />

            <entry value="2048" name="GS_FLAGS_CAMERAS" />
        </enum>
        
    </enums>

    <messages>
        <message id="69" name="SIMBA_TANK_SENSORS">
            <description>Tank temperature sensor readings.</description>
            <!-- temp = float * 10 -->
            <field type="uint8_t[3]" name="oxidizer_temperature"> Oxidizer Tank Temperature </field>
            <field type="uint8_t[1]" name="pfs_temperature"> PFS Tank Temperature </field>
            <field type="uint8_t[2]" name="ethanol_temperature"> Ethanol Tank Temperature </field>
            <field type="uint8_t[1]" name="chamber_temperature"> Chamber Tank Temperature </field>
            <!-- pressure = float * 100 -->
            <field type="uint16_t" name="oxidizer_pressure">Oxidizer Tank pressure</field>
            <field type="uint16_t" name="ethanol_pressure">Ethanol Tank pressure</field>
            <field type="uint16_t" name="pfs_pressure">PFS Tank pressure</field>
        </message>

        <message id="72" name="SIMBA_GPS">
            <description>GPS latitude, longitude and altitude.</description>
            <field type="int32_t" name="lat" units="degE7">Latitude (1E7 * degrees)</field>
            <field type="int32_t" name="lon" units="degE7">Longitude (1E7 * degrees)</field>
            <field type="int32_t" name="altitude" units="cm">Altitude</field>
            <field type="uint8_t" name="sat_number">Number of satellites</field>
        </message>

        <message id="73" name="SIMBA_ROCKET_HEARTBEAT">
            <description>Rocket heartbeat message sent during whole mission.</description>
            <field type="uint64_t" name="timestamp" units="ms">Timestamp (system uptime)</field>
            <field type="uint8_t" name="rocket_state" enum="ROCKET_STATE">Rocket computer state</field>
            <field type="uint16_t" name="values" enum="ACTUATOR_FLAGS" display="bitmask">Actuator bitmask</field>
            <field type="uint8_t" name="primer_state" enum="PRIMER_STATE">Primer State</field>
        </message>

        <message id="74" name="SIMBA_GS_HEARTBEAT">
            <description>Ground station heartbeat.</description>
            <field type="uint64_t" name="timestamp" units="ms">Timestamp (system uptime)</field>
            <field type="uint16_t" name="values" enum="GS_FLAGS" display="bitmask">GS buttons bitmask</field>
        </message>

        <message id="75" name="SIMBA_MAX_ALTITUDE">
            <description>Barometric maximum altitude</description>
            <field type="int32_t" name="altitude" units="cm">Altitude</field>
        </message>

        <message id="77" name="SIMBA_COMPUTERS_TELEMETRY">
            <description> Rocket Computer Usage </description>
            <field type="uint8_t" name="cpu_usage" units="%">Rocket Computer CPU usage (0-100)</field>
            <field type="uint8_t" name="ram_usage" units="%">Rocket Computer RAM usage (0-100)</field>
            <field type="uint8_t[3]" name="board_temperature" units="degC">Rocket Computer Board Temperature (0-128)</field>
            <field type="uint8_t[3]" name="disk_usage" units="%">Rocket Computer Disk usage (system, data, logs) (0-100)</field>
        </message>

        <message id="147" name="SIMBA_ACTUATOR_CMD">
            <description>Direct actuator command (Only in advanced mode, can't be triggered without permission).</description>
            <field type="uint8_t" name="actuator_id">Actuator ID</field>
            <field type="uint8_t" name="value">New actuator value</field>
        </message>

    </messages>

</mavlink>
